{
  "name": "@plushveil/mcp-tools",
  "version": "1.0.0",
  "main": "mcp-tools.js",
  "bin": {
    "tools": "mcp-tools.js"
  },
  "type": "module",
  "types": "mcp-tools.d.ts",
  "scripts": {
    "build": "npm run build:package && npm run build:types",
    "build:package": "esbuild ../../mcp-tools.ts --bundle --platform=node --format=esm --outfile=mcp-tools.js",
    "build:types": "dts-bundle-generator --export-referenced-types false -o types.d.ts ../../types.d.ts",
    "build:methods": "rm -rf methods && cp -r ../../methods ."
  },
  "devDependencies": {
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "^0.27.2"
  }
}
