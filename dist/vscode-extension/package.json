{
	"name": "mcp-tools",
	"displayName": "MCP Tools",
	"description": "Exposes your tool folders as MCP Tools.",
	"version": "0.0.31",
	"publisher": "plushveil",
	"license": "MIT",
	"icon": "icon.png",
	"repository": "https://github.com/plushveil/mcp-tools",
	"engines": {
		"vscode": "^1.108.1"
	},
	"categories": [
		"Other"
	],
	"main": "index.js",
	"activationEvents": [
		"onStartupFinished",
    "workspaceContains:tools/**/*.json",
    "workspaceContains:tools/**/*.md"
  ],
	"contributes": {
		"mcpServerDefinitionProviders": [
			{
				"id": "plushveil.mcp-tools",
				"label": "Tools"
			}
		]
	},
	"scripts": {
		"build": "npm run build:docs && npm run build:extension && npm run build:package",
		"build:docs": "cp ../../.github/README.md ./README.md && cp ../../.github/LICENSE ./LICENSE",
		"build:extension": "tsc -p ./",
		"build:package": "npm run build:package:build && npm run build:package:copy",
		"build:package:build": "cd ../npm-package && npm install && npm run build && cd ../vscode-extension",
		"build:package:copy": "mv ../npm-package/tools.js mcp.js && mv ../npm-package/create-tool.prompt.md create-tool.prompt.md",
		"package": "vsce package && vsce ls --tree"
	},
	"devDependencies": {
		"@types/node": "25.x",
		"@types/vscode": "^1.108.1",
		"@vscode/vsce": "^3.7.1",
		"typescript": "^5.9.3"
	}
}
